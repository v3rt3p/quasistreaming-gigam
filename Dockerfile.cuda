FROM python:3.11-slim

ENV GIGAAM_DEVICE=auto \
    GIGAAM_DOWNLOAD_ROOT=/app/.cache/gigaam \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git libsndfile1 libc++1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.cuda.txt requirements.common.txt ./
RUN pip install --no-cache-dir -r requirements.cuda.txt \
    && pip install --no-cache-dir -r requirements.common.txt

COPY . .
RUN mkdir -p /app/.cache/gigaam

CMD ["python", "quasistreaming-server.py"]
